{
  "expo": {
    "name": "Skyscore",
    "slug": "skyscore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skyscore.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Skyscore uses your location to rate the weather where you are."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1d2a6b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.skyscore.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Skyscore uses your location to rate the weather where you are."
        }
      ]
    ]
  }
}